attr repetition 0
attr replication "#0"
attr resultdir results
attr runnumber 1
attr seedset 1

param **.dispatchMode 1
param **.sat1.host.numTcpApps 12
param **.sat1.host.tcpApp[*].typename "TCPBasicClientApp"
