version 2
run TCPThroughput-0-20260309-141205-28451
attr configname TCPThroughput
attr datetime 20260309-141205
attr experiment TCPThroughput
attr inifile experiments.ini
attr iterationvars "$mode=0"
attr measurement "$mode=0"
attr network RingFdlOBS
attr processid 28451
attr repetition 0
attr replication "#0"
attr resultdir results
attr runnumber 0
attr seedset 0

param **.dispatchMode 0
param **.sat1.host.numTcpApps 12
param **.sat1.host.tcpApp[*].typename "TCPBasicClientApp"
param **.sat1.host.tcpApp[*].numRequestsPerSession 500
param **.sat1.host.tcpApp[*].requestLength 5000B
param **.sat1.host.tcpApp[*].replyLength 100B
