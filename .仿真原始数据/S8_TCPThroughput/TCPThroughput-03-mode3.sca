version 2
run TCPThroughput-3-20260309-143344-28451
attr configname TCPThroughput
attr datetime 20260309-143344
attr experiment TCPThroughput
attr inifile experiments.ini
attr iterationvars "$mode=3"
attr measurement "$mode=3"
attr network RingFdlOBS
attr processid 28451
attr repetition 0
attr replication "#0"
attr resultdir results
attr runnumber 3
attr seedset 3

param **.dispatchMode 3
param **.sat1.host.numTcpApps 12
param **.sat1.host.tcpApp[*].typename "TCPBasicClientApp"
param **.sat1.host.tcpApp[*].numRequestsPerSession 500
param **.sat1.host.tcpApp[*].requestLength 5000B
param **.sat1.host.tcpApp[*].replyLength 100B
param **.sat1.host.tcpApp[*].thinkTime 0s
param **.numQueues 8
param sim-time-limit 15s

scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Dispatch Mode" 3
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Packets received" 7192
