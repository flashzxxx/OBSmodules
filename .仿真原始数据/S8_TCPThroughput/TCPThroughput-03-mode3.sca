scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Total Dispatched" 6580
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P1 Hits (Busy Match)" 2564
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P2 Hits (Idle Reuse)" 2320
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P3 Hits (Fresh Idle)" 1696
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P4 Hits (LRU Preemption)" 0
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Force Flush Count" 0
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Drop Rate (%)" 10.2000
scalar RingFdlOBS.sat1.host "TCP Requests Sent" 6000
scalar RingFdlOBS.sat1.host "TCP Requests Completed" 4983
scalar RingFdlOBS.sat1.host "TCP Retransmissions" 387
scalar RingFdlOBS.sat1.host "Avg Throughput (Kbps/flow)" 218.5000
