version 2
run LoadIntensity-13-20251217-094354-28451
attr configname LoadIntensity
attr datetime 20251217-094354
attr experiment LoadIntensity
attr inifile experiments.ini
attr iterationvars "$mode=2, $interval=0.002s"
attr measurement "$mode=2, $interval=0.002s"
attr network RingFdlOBS
attr processid 28451
attr repetition 0
attr replication "#0"
attr resultdir results
attr runnumber 13
attr seedset 13

param **.dispatchMode 2
param **.sat1.host.numUdpApps 10
param **.sat1.host.udpApp[*].sendInterval 0.002s
param **.sat1.host.udpApp[*].messageLength 500B
param **.packetBurstifier[*].timeout 0.01s
param **.numQueues 8
param sim-time-limit 4s

scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Dispatch Mode" 2
