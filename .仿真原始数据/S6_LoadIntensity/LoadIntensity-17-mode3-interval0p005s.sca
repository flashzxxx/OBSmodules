scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P1 Hits (Busy Match)" 1920
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P2 Hits (Idle Reuse)" 1687
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P3 Hits (Fresh Idle)" 1238
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P4 Hits (LRU Preemption)" 0
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Force Flush Count" 0
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Drop Rate (%)" 3.1000
