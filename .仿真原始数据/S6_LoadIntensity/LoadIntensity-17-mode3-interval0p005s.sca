version 2
run LoadIntensity-17-20251217-091146-28451
attr configname LoadIntensity
attr datetime 20251217-091146
attr experiment LoadIntensity
attr inifile experiments.ini
attr iterationvars "$mode=3, $interval=0.005s"
attr measurement "$mode=3, $interval=0.005s"
attr network RingFdlOBS
attr processid 28451
attr repetition 0
attr replication "#0"
attr resultdir results
attr runnumber 17
attr seedset 17

param **.dispatchMode 3
param **.sat1.host.numUdpApps 10
param **.sat1.host.udpApp[*].sendInterval 0.005s
param **.sat1.host.udpApp[*].messageLength 500B
param **.packetBurstifier[*].timeout 0.01s
param **.numQueues 8
param sim-time-limit 4s

scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Dispatch Mode" 3
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Packets received" 5000
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Dropped Packets" 155
