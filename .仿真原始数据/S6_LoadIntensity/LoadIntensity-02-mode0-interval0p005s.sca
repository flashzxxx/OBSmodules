version 2
run LoadIntensity-2-20251217-092631-28451
attr configname LoadIntensity
attr datetime 20251217-092631
attr experiment LoadIntensity
attr inifile experiments.ini
attr iterationvars "$mode=0, $interval=0.005s"
attr measurement "$mode=0, $interval=0.005s"
attr network RingFdlOBS
attr processid 28451
attr repetition 0
attr replication "#0"
attr resultdir results
attr runnumber 2
attr seedset 2

param **.dispatchMode 0
param **.sat1.host.numUdpApps 10
param **.sat1.host.udpApp[*].sendInterval 0.005s
param **.sat1.host.udpApp[*].messageLength 500B
param **.packetBurstifier[*].timeout 0.01s
param **.numQueues 8
param sim-time-limit 4s

scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Dispatch Mode" 0
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Packets received" 5000
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Dropped Packets" 0
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Total Dispatched" 5000
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P1 Hits (Busy Match)" 3576
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P2 Hits (Idle Reuse)" 898
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P3 Hits (Fresh Idle)" 462
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P4 Hits (LRU Preemption)" 64
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Force Flush Count" 64
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Drop Rate (%)" 0
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Avg Burst Aggregation" 3.5000
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Total Bursts Generated" 71
