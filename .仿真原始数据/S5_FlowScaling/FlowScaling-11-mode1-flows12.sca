version 2
run FlowScaling-11-20251215-142928-28451
attr configname FlowScaling
attr datetime 20251215-142928
attr experiment FlowScaling
attr inifile experiments.ini
attr iterationvars "$mode=1, $flows=12"
attr measurement "$mode=1, $flows=12"
attr network RingFdlOBS
attr processid 28451
attr repetition 0
attr replication "#0"
attr resultdir results
attr runnumber 11
attr seedset 11

param **.dispatchMode 1
param **.sat1.host.numUdpApps 12
param **.sat1.host.udpApp[*].sendInterval 0.002s
