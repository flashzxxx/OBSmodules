scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P1 Hits (Busy Match)" 815
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P2 Hits (Idle Reuse)" 204
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P3 Hits (Fresh Idle)" 131
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P4 Hits (LRU Preemption)" 0
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Force Flush Count" 0
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Drop Rate (%)" 0
scalar RingFdlOBS.sat1.edgeRouter.packetBurstifier[0] "Bursts assembled" 28
scalar RingFdlOBS.sat1.edgeRouter.packetBurstifier[0] "Packets burstified" 145
scalar RingFdlOBS.sat1.edgeRouter.packetBurstifier[1] "Bursts assembled" 29
scalar RingFdlOBS.sat1.edgeRouter.packetBurstifier[1] "Packets burstified" 146
