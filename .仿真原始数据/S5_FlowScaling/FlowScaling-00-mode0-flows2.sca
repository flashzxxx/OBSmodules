version 2
run FlowScaling-0-20251215-141205-28451
attr configname FlowScaling
attr datetime 20251215-141205
attr experiment FlowScaling
attr inifile experiments.ini
attr iterationvars "$mode=0, $flows=2"
attr measurement "$mode=0, $flows=2"
attr network RingFdlOBS
attr processid 28451
attr repetition 0
attr replication "#0"
attr resultdir results
attr runnumber 0
attr seedset 0

param **.dispatchMode 0
param **.sat1.host.numUdpApps 2
param **.sat1.host.udpApp[*].sendInterval 0.002s
param **.sat1.host.udpApp[*].messageLength 500B
param **.packetBurstifier[*].timeout 0.01s
param **.packetBurstifier[*].numPackets 1000
param **.numQueues 8
param sim-time-limit 4s

scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Dispatch Mode" 0
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Packets received" 1150
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Dropped Packets" 0
