version 2
run FlowScaling-1-20251215-141918-28451
attr configname FlowScaling
attr datetime 20251215-141918
attr experiment FlowScaling
attr inifile experiments.ini
attr iterationvars "$mode=0, $flows=4"
attr measurement "$mode=0, $flows=4"
attr network RingFdlOBS
attr processid 28451
attr repetition 0
attr replication "#0"
attr resultdir results
attr runnumber 1
attr seedset 1

param **.dispatchMode 0
param **.sat1.host.numUdpApps 4
param **.sat1.host.udpApp[*].sendInterval 0.002s
