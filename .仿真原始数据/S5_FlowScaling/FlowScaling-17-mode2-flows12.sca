version 2
run FlowScaling-17-20251215-141146-28451
attr configname FlowScaling
attr datetime 20251215-141146
attr experiment FlowScaling
attr inifile experiments.ini
attr iterationvars "$mode=2, $flows=12"
attr measurement "$mode=2, $flows=12"
attr network RingFdlOBS
attr processid 28451
attr repetition 0
attr replication "#0"
attr resultdir results
attr runnumber 17
attr seedset 17

param **.dispatchMode 2
