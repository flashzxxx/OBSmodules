version 2
run FlowScaling-22-20251215-144651-28451
attr configname FlowScaling
attr datetime 20251215-144651
attr experiment FlowScaling
attr inifile experiments.ini
attr iterationvars "$mode=3, $flows=10"
attr measurement "$mode=3, $flows=10"
attr network RingFdlOBS
attr processid 28451
attr repetition 0
attr replication "#0"
attr resultdir results
attr runnumber 22
attr seedset 22

param **.dispatchMode 3
