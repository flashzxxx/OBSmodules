version 2
run FlowScaling-14-20251215-145007-28451
attr configname FlowScaling
attr datetime 20251215-145007
attr experiment FlowScaling
attr inifile experiments.ini
attr iterationvars "$mode=2, $flows=6"
attr measurement "$mode=2, $flows=6"
attr network RingFdlOBS
attr processid 28451
attr repetition 0
attr replication "#0"
attr resultdir results
attr runnumber 14
attr seedset 14

param **.dispatchMode 2
param **.sat1.host.numUdpApps 6
param **.sat1.host.udpApp[*].sendInterval 0.002s
param **.sat1.host.udpApp[*].messageLength 500B
param **.packetBurstifier[*].timeout 0.01s
param **.packetBurstifier[*].numPackets 1000
param **.numQueues 8
param sim-time-limit 4s

scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Dispatch Mode" 2
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Packets received" 3450
