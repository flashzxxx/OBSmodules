version 2
run FlowScaling-5-20251215-144710-28451
attr configname FlowScaling
attr datetime 20251215-144710
attr experiment FlowScaling
attr inifile experiments.ini
attr iterationvars "$mode=0, $flows=12"
attr measurement "$mode=0, $flows=12"
attr network RingFdlOBS
attr processid 28451
attr repetition 0
attr replication "#0"
attr resultdir results
attr runnumber 5
attr seedset 5

param **.dispatchMode 0
