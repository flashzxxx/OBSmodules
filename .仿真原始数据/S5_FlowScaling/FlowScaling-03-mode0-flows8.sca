version 2
run FlowScaling-3-20251215-143344-28451
attr configname FlowScaling
attr datetime 20251215-143344
attr experiment FlowScaling
attr inifile experiments.ini
attr iterationvars "$mode=0, $flows=8"
attr measurement "$mode=0, $flows=8"
attr network RingFdlOBS
attr processid 28451
attr repetition 0
attr replication "#0"
attr resultdir results
attr runnumber 3
attr seedset 3

