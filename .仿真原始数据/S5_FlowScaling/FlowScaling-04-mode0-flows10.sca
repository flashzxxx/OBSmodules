version 2
run FlowScaling-4-20251215-144057-28451
attr configname FlowScaling
attr datetime 20251215-144057
attr experiment FlowScaling
attr inifile experiments.ini
attr iterationvars "$mode=0, $flows=10"
attr measurement "$mode=0, $flows=10"
attr network RingFdlOBS
attr processid 28451
attr repetition 0
attr replication "#0"
attr resultdir results
attr runnumber 4
attr seedset 4

param **.dispatchMode 0
param **.sat1.host.numUdpApps 10
param **.sat1.host.udpApp[*].sendInterval 0.002s
param **.sat1.host.udpApp[*].messageLength 500B
param **.packetBurstifier[*].timeout 0.01s
param **.packetBurstifier[*].numPackets 1000
param **.numQueues 8
param sim-time-limit 4s

