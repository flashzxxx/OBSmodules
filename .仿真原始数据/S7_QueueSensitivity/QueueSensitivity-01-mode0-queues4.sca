version 2
run QueueSensitivity-1-20260116-101918-28451
attr configname QueueSensitivity
attr datetime 20260116-101918
attr experiment QueueSensitivity
attr inifile experiments.ini
attr iterationvars "$mode=0, $queues=4"
attr measurement "$mode=0, $queues=4"
attr network RingFdlOBS
attr processid 28451
attr repetition 0
attr replication "#0"
attr resultdir results
attr runnumber 1
attr seedset 1

param **.dispatchMode 0
param **.numQueues 4
param **.sat1.host.numUdpApps 10
param **.sat1.host.udpApp[*].sendInterval 0.002s
param **.packetBurstifier[*].timeout 0.01s
param sim-time-limit 4s

scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Dispatch Mode" 0
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Num Queues" 4
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Resource Overload Ratio" 2.5000
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Packets received" 5750
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Dropped Packets" 0
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Total Dispatched" 5750
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P1 Hits (Busy Match)" 4192
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P2 Hits (Idle Reuse)" 1030
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P3 Hits (Fresh Idle)" 116
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P4 Hits (LRU Preemption)" 412
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Force Flush Count" 412
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Drop Rate (%)" 0
