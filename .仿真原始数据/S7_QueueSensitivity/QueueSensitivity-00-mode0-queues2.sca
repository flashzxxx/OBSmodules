scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Dropped Packets" 69
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Total Dispatched" 5681
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P1 Hits (Busy Match)" 4205
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P2 Hits (Idle Reuse)" 1050
