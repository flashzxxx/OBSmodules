scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Dropped Packets" 276
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Total Dispatched" 5474
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P1 Hits (Busy Match)" 3765
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P2 Hits (Idle Reuse)" 1066
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P3 Hits (Fresh Idle)" 643
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P4 Hits (LRU Preemption)" 0
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Force Flush Count" 0
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Drop Rate (%)" 4.8000
