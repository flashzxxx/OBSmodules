version 2
run QueueSensitivity-4-20260116-104057-28451
attr configname QueueSensitivity
attr datetime 20260116-104057
attr experiment QueueSensitivity
attr inifile experiments.ini
attr iterationvars "$mode=1, $queues=2"
attr measurement "$mode=1, $queues=2"
attr network RingFdlOBS
attr processid 28451
attr repetition 0
attr replication "#0"
attr resultdir results
attr runnumber 4
attr seedset 4

param **.dispatchMode 1
param **.numQueues 2
param **.sat1.host.numUdpApps 10
param **.sat1.host.udpApp[*].sendInterval 0.002s
param **.packetBurstifier[*].timeout 0.01s
param sim-time-limit 4s

scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Dispatch Mode" 1
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Num Queues" 2
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Resource Overload Ratio" 5.0000
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Packets received" 5750
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Dropped Packets" 2443
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Total Dispatched" 3307
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P1 Hits (Busy Match)" 2172
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P2 Hits (Idle Reuse)" 649
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P3 Hits (Fresh Idle)" 486
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P4 Hits (LRU Preemption)" 0
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Force Flush Count" 0
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Drop Rate (%)" 42.5000
