version 2
run QueueSensitivity-9-20260116-101502-28451
attr configname QueueSensitivity
attr datetime 20260116-101502
attr experiment QueueSensitivity
attr inifile experiments.ini
attr iterationvars "$mode=2, $queues=4"
attr measurement "$mode=2, $queues=4"
attr network RingFdlOBS
attr processid 28451
attr repetition 0
attr replication "#0"
attr resultdir results
attr runnumber 9
attr seedset 9

param **.dispatchMode 2
param **.numQueues 4
param **.sat1.host.numUdpApps 10
param **.sat1.host.udpApp[*].sendInterval 0.002s
param **.packetBurstifier[*].timeout 0.01s
param sim-time-limit 4s

scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Dispatch Mode" 2
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Num Queues" 4
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Resource Overload Ratio" 2.5000
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Packets received" 5750
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Dropped Packets" 178
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Total Dispatched" 5572
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P1 Hits (Busy Match)" 0
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P2 Hits (Idle Reuse)" 3854
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P3 Hits (Fresh Idle)" 1718
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "P4 Hits (LRU Preemption)" 0
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Force Flush Count" 447
scalar RingFdlOBS.sat1.edgeRouter.packetDispatcher "Drop Rate (%)" 3.1000
