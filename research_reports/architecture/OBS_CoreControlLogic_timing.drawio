<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Page-1 直通时间轴">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t1" value="场景 A（直通）：OXC 预约的时间轴" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="400" y="30" width="800" height="44" as="geometry" />
        </mxCell>

        <mxCell id="t2" value="示例参数：burstLength = 12500 B，dataRate = 10 Gbps ⇒ burstDuration = 10 μs；guardTime = 2 μs；burstArrival = 30 μs" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="200" y="84" width="1200" height="32" as="geometry" />
        </mxCell>

        <mxCell id="axis1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150" y="340" as="sourcePoint" />
            <mxPoint x="1350" y="340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="axist" value="时间 t (μs) →" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1360" y="328" width="140" height="24" as="geometry" />
        </mxCell>

        <mxCell id="tick1" value="" style="rounded=0;html=1;fillColor=#333333;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="389" y="320" width="2" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tick1t" value="29" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="370" y="296" width="40" height="24" as="geometry" />
        </mxCell>

        <mxCell id="tick2" value="" style="rounded=0;html=1;fillColor=#333333;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="449" y="320" width="2" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tick2t" value="30" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="430" y="296" width="40" height="24" as="geometry" />
        </mxCell>
        <mxCell id="tick2n" value="burst 到达" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="395" y="250" width="110" height="24" as="geometry" />
        </mxCell>

        <mxCell id="tick3" value="" style="rounded=0;html=1;fillColor=#333333;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1049" y="320" width="2" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tick3t" value="40" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1030" y="296" width="40" height="24" as="geometry" />
        </mxCell>
        <mxCell id="tick3n" value="burst 结束" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="995" y="250" width="110" height="24" as="geometry" />
        </mxCell>

        <mxCell id="tick4" value="" style="rounded=0;html=1;fillColor=#333333;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1139" y="320" width="2" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tick4t" value="41.5" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1110" y="296" width="50" height="24" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="390" y="390" width="60" height="56" as="geometry" />
        </mxCell>
        <mxCell id="b1t" value="建链&#xa;guardTime/2 = 1 μs" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#a98215;" vertex="1" parent="1">
          <mxGeometry x="360" y="452" width="120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="450" y="390" width="600" height="56" as="geometry" />
        </mxCell>
        <mxCell id="b2t" value="burst 占用&#xa;burstDuration = 10 μs" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#3f7a3a;" vertex="1" parent="1">
          <mxGeometry x="690" y="452" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1050" y="390" width="90" height="56" as="geometry" />
        </mxCell>
        <mxCell id="b3t" value="拆链 40.5 → 释放 41.5&#xa;3·guardTime/4 = 1.5 μs" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#a97400;" vertex="1" parent="1">
          <mxGeometry x="1000" y="452" width="190" height="40" as="geometry" />
        </mxCell>

        <mxCell id="note1" value="horizon = burstArrival + burstDuration + 3·guardTime/4&#xa;= 下一个 burst 最早可安全占用该通道的时刻" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="320" y="560" width="620" height="70" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="connectTime&#xa;= burstArrival − guardTime/2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="disconnectTime&#xa;= burstArrival + burstDuration&#xa;+ guardTime/4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1280" y="150" width="270" height="80" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Page-2 FDL回环+offset">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t1" value="场景 B（FDL 回环）：两段预约 + offset 更新" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="800" height="44" as="geometry" />
        </mxCell>

        <mxCell id="seg1l" value="第一段  in → FDL（锚点 burstArrival = 30 μs）" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="150" y="74" width="520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="axis1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150" y="150" as="sourcePoint" />
            <mxPoint x="1350" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p1a" value="" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="390" y="170" width="60" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p1b" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="450" y="170" width="600" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p1c" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1050" y="170" width="90" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p1n" value="29 建链　30 burst 入　40 出　41.5 FDL 空闲" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="390" y="222" width="750" height="24" as="geometry" />
        </mxCell>

        <mxCell id="seg2l" value="第二段  FDL → out（锚点 delayedArrival = burstArrival + τ = 40 μs）" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="150" y="286" width="700" height="28" as="geometry" />
        </mxCell>
        <mxCell id="axis2" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150" y="362" as="sourcePoint" />
            <mxPoint x="1350" y="362" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2a" value="" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="390" y="382" width="60" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p2b" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="450" y="382" width="600" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p2c" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1050" y="382" width="90" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p2n" value="39 建链　40 burst 出　50 结束　51.5 目标通道空闲" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="390" y="434" width="750" height="24" as="geometry" />
        </mxCell>

        <mxCell id="shift" value="第二段 = 第一段整体平移 τ = 10 μs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1150" y="130" width="300" height="50" as="geometry" />
        </mxCell>

        <mxCell id="off1" value="直通：arrivalDelta′ = arrivalDelta − processingTime&#xa;　　　 = 30 − 1 = 29 μs" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="150" y="520" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="off2" value="回环：arrivalDelta′ = arrivalDelta + τ − processingTime&#xa;　　　 = 30 + 10 − 1 = 39 μs" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="150" y="610" width="560" height="70" as="geometry" />
        </mxCell>

        <mxCell id="offn" value="offset 始终追踪「BCP 领先 burst 到达下一节点的时间差」&#xa;直通：burst 不延迟，只减去本节点 BCP 处理 1 μs&#xa;回环：burst 在 FDL 多待 τ，offset 相应 +10 μs" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="780" y="520" width="600" height="160" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
