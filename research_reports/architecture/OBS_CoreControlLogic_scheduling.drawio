          <mxGeometry x="290" y="652" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="11" value="* 通配&#xa;findNearestLambda(outPort, burstArrival)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="30" y="782" width="260" height="56" as="geometry" />
        </mxCell>

        <mxCell id="12" value="lambda != -1?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
