<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="OBS_CoreControlLogic 调度流程">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="60" value="OBS_CoreControlLogic 调度决策流程" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="210" y="10" width="400" height="36" as="geometry" />
        </mxCell>

        <mxCell id="2" value="handleMessage(msg)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="70" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="3" value="msg.getKind()?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="290" y="160" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="4" value="OXC 自动消息&#xa;kind=1 → setGate&#xa;kind=2 → unsetGate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="600" y="155" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="5" value="提取 BCP 字段&#xa;(colour, port, Δ, len, label)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="290" width="220" height="56" as="geometry" />
        </mxCell>

        <mxCell id="6" value="burstArrival = simTime() + arrivalDelta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="376" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="7" value="burstArrival &lt; simTime()?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="290" y="456" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="8" value="丢弃 case 1&#xa;(BCP 迟于 burst)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="600" y="460" width="180" height="72" as="geometry" />
