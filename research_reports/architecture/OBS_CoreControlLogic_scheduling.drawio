        <mxCell id="13" value="指定通道&#xa;λ = getLambdaByColour(outPort, outColour)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="520" y="782" width="280" height="56" as="geometry" />
        </mxCell>

