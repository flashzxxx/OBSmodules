# ==========================================
# OMNeT++ OBS Modules Project .gitignore
# ==========================================

# --- OMNeT++ / GCC Build Artifacts ---
# Exclude build output directory
/out/
# Exclude object files and dependency files
*.o
*.d
# Exclude compiled libraries and executables
*.so
*.dll
*.exe
/obsmodules
/obsmodules.cmd

# --- IDE Config Files ---
# Exclude OMNeT++ Eclipse configuration
.oppbuildspec
.settings/

# --- Simulation Outputs ---
# Exclude simulation results under any results/ directory
**/results/*.sca
**/results/*.vec
**/results/*.vci
# Exclude simulation runtime logs and pdf charts in Examples
*.log
.tkenvlog
.tkenvrc
Rplots.pdf
# Exclude R plots or specific png figures inside results directories
**/results/fig_*.png
**/results/*.txt

# --- Simulation Raw Data ---
# Exclude historical raw simulation data and archive
/仿真原始数据/
/仿真原始数据.zip

# --- Keep Results Directories ---
# Do not ignore .gitkeep files so results/ dirs are tracked by Git
!**/results/.gitkeep
